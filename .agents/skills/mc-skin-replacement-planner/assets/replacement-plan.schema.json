{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcskinsplit.local/schemas/replacement-plan.schema.json",
  "title": "MCSkinSplit restoration replacement recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "compositionId",
    "candidateSetHash",
    "decisions",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "jobId": { "type": "string", "minLength": 3, "maxLength": 120 },
    "compositionId": { "type": "string", "minLength": 3, "maxLength": 120 },
    "candidateSetHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decisions": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/decision" }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 300 }
  },
  "$defs": {
    "candidateId": {
      "type": "string",
      "pattern": "^restore_[0-9a-f]{64}$"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetGroupId",
        "selectedCandidateId",
        "rankedCandidateIds",
        "confidence",
        "explanation"
      ],
      "properties": {
        "targetGroupId": {
          "type": "string",
          "pattern": "^(head|torso|leftArm|rightArm|leftLeg|rightLeg)_base$"
        },
        "selectedCandidateId": {
          "oneOf": [{ "$ref": "#/$defs/candidateId" }, { "type": "null" }]
        },
        "rankedCandidateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/candidateId" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    }
  }
}
